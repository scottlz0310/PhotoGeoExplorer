<Project Sdk="Microsoft.NET.Sdk">

  <!-- スパイク #293 の P1。photo-map-studio（b856d7d）の Geo / Tiles/Vector のソースを、コピーせずリンクで取り込む。main へはマージしない -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhotoMapStudio.Spike</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisMode>None</AnalysisMode>
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8604;CS8602</NoWarn>
    <PhotoMapStudioRoot>$(MSBuildThisFileDirectory)..\..\photo-map-studio</PhotoMapStudioRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui" Version="5.1.0" />
    <PackageReference Include="Mapsui.Nts" Version="5.1.0" />
    <PackageReference Include="Mapsui.Rendering.Skia" Version="5.1.0" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.156.0" />
    <PackageReference Include="PhotoMapStudio.Tiles" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(PhotoMapStudioRoot)\src\PhotoMapStudio.Core\Geo\*.cs" LinkBase="PhotoMapStudio\Geo" />
    <Compile Include="$(PhotoMapStudioRoot)\src\PhotoMapStudio.Core\Tiles\Vector\*.cs" LinkBase="PhotoMapStudio\Vector" />
  </ItemGroup>

</Project>
