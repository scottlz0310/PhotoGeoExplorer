<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="SettingsPaneTemplate">
        <ScrollViewer>
            <Grid Padding="16" MaxWidth="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
                    <TextBlock
                        Text="{Binding Title}"
                        Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="SettingsPaneSubtitle"
                        Text="アプリケーション設定"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Opacity="0.7" />
                </StackPanel>

                <!-- 変更状態とアクションボタン -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                    <Button
                        x:Uid="SettingsPaneResetButton"
                        Content="リセット"
                        Command="{Binding ResetCommand}" />
                    <TextBlock
                        x:Uid="SettingsPaneAutoSaveHint"
                        Text="変更は自動的に保存されます"
                        VerticalAlignment="Center"
                        Opacity="0.7"
                        Margin="8,0,0,0" />
                </StackPanel>

                <!-- 設定項目 -->
                <StackPanel Grid.Row="2" Spacing="24">
                    <!-- 言語設定 -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneLanguageSection"
                            Text="言語"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ComboBox
                            x:Uid="SettingsPaneLanguageSelector"
                            x:Name="LanguageComboBox"
                            Header="表示言語"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding Language, Mode=TwoWay}"
                            MinWidth="200">
                            <ComboBoxItem
                                x:Uid="SettingsPaneLanguageSystemOption"
                                Content="システムデフォルト"
                                Tag="system" />
                            <ComboBoxItem
                                x:Uid="SettingsPaneLanguageJapaneseOption"
                                Content="日本語"
                                Tag="ja-JP" />
                            <ComboBoxItem
                                x:Uid="SettingsPaneLanguageEnglishOption"
                                Content="English"
                                Tag="en-US" />
                        </ComboBox>
                        <TextBlock
                            x:Uid="SettingsPaneLanguageRestartHint"
                            Text="言語を変更した後は、アプリを再起動してください。"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Opacity="0.7" />
                    </StackPanel>

                    <!-- テーマ設定 -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneThemeSection"
                            Text="外観"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <RadioButtons
                            x:Uid="SettingsPaneThemeSelector"
                            Header="テーマ"
                            SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                            <RadioButton
                                x:Uid="SettingsPaneThemeSystemOption"
                                Content="システムデフォルト" />
                            <RadioButton
                                x:Uid="SettingsPaneThemeLightOption"
                                Content="ライトモード" />
                            <RadioButton
                                x:Uid="SettingsPaneThemeDarkOption"
                                Content="ダークモード" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- 地図設定 -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneMapSection"
                            Text="地図"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <NumberBox
                            x:Uid="SettingsPaneMapZoom"
                            Header="デフォルトズームレベル"
                            Value="{Binding MapDefaultZoomLevelValue, Mode=TwoWay}"
                            Minimum="8"
                            Maximum="18"
                            SpinButtonPlacementMode="Inline"
                            MinWidth="200" />
                        <RadioButtons
                            x:Uid="SettingsPaneMapTileSource"
                            Header="地図タイルソース"
                            SelectedIndex="{Binding MapTileSourceIndex, Mode=TwoWay}">
                            <RadioButton
                                x:Uid="SettingsPaneMapTileSourceOsm"
                                Content="OpenStreetMap" />
                            <RadioButton
                                x:Uid="SettingsPaneMapTileSourceEsri"
                                Content="Esri World Imagery (衛星)" />
                        </RadioButtons>
                    </StackPanel>

                    <!-- 表示設定 -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneDisplaySection"
                            Text="表示"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ToggleSwitch
                            x:Uid="SettingsPaneShowImagesOnly"
                            Header="画像ファイルのみ表示"
                            IsOn="{Binding ShowImagesOnly, Mode=TwoWay}" />
                        <ToggleSwitch
                            x:Uid="SettingsPaneShowQuickStartOnStartup"
                            Header="起動時にクイックスタートを表示"
                            IsOn="{Binding ShowQuickStartOnStartup, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- インポート/エクスポート -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneManage"
                            Text="設定の管理"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="SettingsPaneExportButton"
                                Content="エクスポート..."
                                Command="{Binding ExportCommand}" />
                            <Button
                                x:Uid="SettingsPaneImportButton"
                                Content="インポート..."
                                Command="{Binding ImportCommand}" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="SettingsPaneManageDescription"
                            Text="設定をファイルにエクスポートしたり、ファイルからインポートすることができます。"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 最後に開いたフォルダ -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="SettingsPaneLastFolderSection"
                            Text="最後に開いたフォルダ"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="{Binding LastFolderPath}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Opacity="0.7"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
