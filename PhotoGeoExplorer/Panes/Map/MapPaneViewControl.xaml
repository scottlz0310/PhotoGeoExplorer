<UserControl
    x:Class="PhotoGeoExplorer.Panes.Map.MapPaneViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhotoGeoExplorer.Panes.Map"
    xmlns:mapsui="using:Mapsui.UI.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DataContextChanged="OnDataContextChanged"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <MenuFlyout x:Name="MapHeaderMenu" Opening="OnMapHeaderMenuOpening">
                <ToggleMenuFlyoutItem
                    x:Name="MapHeaderMenuShowAddress"
                    x:Uid="MapHeaderMenuShowAddress"
                    Text="Show address"
                    Click="OnMapHeaderMenuItemClicked" />
                <ToggleMenuFlyoutItem
                    x:Name="MapHeaderMenuShowRoadName"
                    x:Uid="MapHeaderMenuShowRoadName"
                    Text="Show nearest road name"
                    Click="OnMapHeaderMenuItemClicked" />
                <ToggleMenuFlyoutItem
                    x:Name="MapHeaderMenuShowCoordinates"
                    x:Uid="MapHeaderMenuShowCoordinates"
                    Text="Show latitude and longitude"
                    Click="OnMapHeaderMenuItemClicked" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem
                    x:Name="MapHeaderMenuIncludePrefecture"
                    x:Uid="MapHeaderMenuIncludePrefecture"
                    Text="Include prefecture in address"
                    Click="OnMapHeaderMenuItemClicked" />
            </MenuFlyout>
            <Flyout x:Name="MarkerFlyout" Placement="Top">
                <StackPanel Spacing="8" MinWidth="280" MaxWidth="320" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="FlyoutTakenAtLabel"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Opacity="0.7" />
                        <TextBlock
                            x:Name="FlyoutTakenAt"
                            FontSize="14"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="FlyoutCameraPanel" Spacing="4">
                        <TextBlock
                            x:Name="FlyoutCameraLabel"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Opacity="0.7" />
                        <TextBlock
                            x:Name="FlyoutCamera"
                            FontSize="14"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="FlyoutFileLabel"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Opacity="0.7" />
                        <TextBlock
                            x:Name="FlyoutFileName"
                            FontSize="14"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="FlyoutResolutionPanel" Spacing="4">
                        <TextBlock
                            x:Name="FlyoutResolutionLabel"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Opacity="0.7" />
                        <TextBlock
                            x:Name="FlyoutResolution"
                            FontSize="14" />
                    </StackPanel>

                    <HyperlinkButton
                        x:Name="FlyoutGoogleMapsLink"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        Click="OnGoogleMapsLinkClicked" />
                </StackPanel>
            </Flyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Background がないと、余白で RightTapped が発生しない -->
        <Grid
            x:Name="MapHeaderBar"
            Background="Transparent"
            ColumnSpacing="12"
            RightTapped="OnMapHeaderRightTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="Map"
                FontSize="20"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                x:Uid="MapHeader" />
            <!-- 幅が足りないときの省略順は、コードビハインド（ConfigureMapHeaderCollapse）で指定する -->
            <local:PriorityCollapsePanel
                x:Name="MapHeaderLocationPanel"
                Grid.Column="1"
                Spacing="8"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="MapHeaderLocationInfo">
                <TextBlock
                    x:Name="MapHeaderAreaName"
                    VerticalAlignment="Center"
                    Text="{Binding LocationInfo.AreaNameText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding LocationInfo.AreaNameVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="{Binding LocationInfo.AreaNameToolTip, Mode=OneWay}"
                    AutomationProperties.AutomationId="MapHeaderAreaName" />
                <TextBlock
                    x:Name="MapHeaderAreaSeparator"
                    VerticalAlignment="Center"
                    Opacity="0.4"
                    Text="│" />
                <Grid
                    x:Name="MapHeaderRoad"
                    VerticalAlignment="Center"
                    ColumnSpacing="4"
                    Visibility="{Binding LocationInfo.RoadNameVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="MapHeaderRoadLabel"
                        Opacity="0.7"
                        Text="Road:" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding LocationInfo.RoadNameText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.AutomationId="MapHeaderRoadName" />
                </Grid>
                <TextBlock
                    x:Name="MapHeaderRoadSeparator"
                    VerticalAlignment="Center"
                    Opacity="0.4"
                    Text="│" />
                <Button
                    x:Name="MapHeaderCoordinatesButton"
                    x:Uid="MapHeaderCoordinatesButton"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCopyCoordinatesClicked"
                    Content="{Binding LocationInfo.CoordinatesText, Mode=OneWay}"
                    Visibility="{Binding LocationInfo.CoordinatesVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="Click to copy the latitude and longitude"
                    AutomationProperties.AutomationId="MapHeaderCoordinates" />
            </local:PriorityCollapsePanel>
            <Button
                Grid.Column="2"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="MapImageSaveButton"
                Click="OnSaveMapImageClicked"
                IsEnabled="{Binding CanSaveMapImage, Mode=OneWay}"
                ToolTipService.ToolTip="Save map image"
                x:Uid="MapImageSaveButton">
                <SymbolIcon Symbol="Save" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" />
            <Grid x:Name="MapHost">
                <mapsui:MapControl
                    x:Name="MapControl"
                    AutomationProperties.AutomationId="MapControl"
                    Info="OnMapInfoReceived"
                    SizeChanged="OnMapControlSizeChanged"
                    PointerCaptureLost="OnMapPointerCaptureLost"
                    PointerMoved="OnMapPointerMoved"
                    PointerPressed="OnMapPointerPressed"
                    PointerReleased="OnMapPointerReleased" />
            </Grid>
            <Border
                Margin="8"
                Padding="8,4"
                CornerRadius="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding BackgroundNoticeVisibility, Mode=OneWay}"
                AutomationProperties.AutomationId="MapBackgroundNotice"
                IsHitTestVisible="False">
                <TextBlock
                    Text="{Binding BackgroundNotice, Mode=OneWay}"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </Border>
            <Border
                x:Name="MapStatusOverlay"
                Background="#D0000000"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
            <Border
                x:Name="MapStatusPanel"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="MapStatusPanel"
                IsHitTestVisible="False">
                <StackPanel Spacing="8" MaxWidth="320" HorizontalAlignment="Center">
                    <SymbolIcon
                        x:Name="MapStatusIcon"
                        Symbol="Map"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="MapStatusTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        AutomationProperties.AutomationId="MapStatusTitle"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="MapStatusDescription"
                        Opacity="0.7"
                        TextAlignment="Center"
                        AutomationProperties.AutomationId="MapStatusDescription"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
