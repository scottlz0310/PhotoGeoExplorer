<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PhotoGeoExplorer.Panes.Map.MapImageExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="MapImageExportDialog"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="None"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    IsPrimaryButtonEnabled="{Binding CanSave, Mode=OneWay}"
    Title="Save map image"
    PrimaryButtonText="Save..."
    CloseButtonText="Cancel">

    <!--  既定ボタンを置くと、入力欄の値を Enter で確定する前に保存へ進むため、置かない  -->

    <ContentDialog.Resources>
        <!--  プレビューと設定を横に並べるため、既定の幅の上限を広げる  -->
        <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto">
        <Grid Width="760" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border
                Height="360"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="4">
                <Grid>
                    <Image
                        x:Name="PreviewImage"
                        x:Uid="MapImageExportPreview"
                        AutomationProperties.AutomationId="MapImageExportPreview"
                        Stretch="Uniform" />
                    <ProgressRing
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{Binding IsRendering, Mode=OneWay}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <ComboBox
                    x:Uid="MapImageExportSize"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="MapImageExportSize"
                    Header="Size"
                    ItemsSource="{Binding SizeChoices}"
                    SelectedIndex="{Binding SizeIndex, Mode=TwoWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="WidthBox"
                        x:Uid="MapImageExportWidth"
                        AutomationProperties.AutomationId="MapImageExportWidth"
                        Header="Width (px)"
                        IsEnabled="{Binding IsCustomSize, Mode=OneWay}"
                        Value="{Binding Width, Mode=TwoWay}" />
                    <NumberBox
                        x:Name="HeightBox"
                        x:Uid="MapImageExportHeight"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="MapImageExportHeight"
                        Header="Height (px)"
                        IsEnabled="{Binding IsCustomSize, Mode=OneWay}"
                        Value="{Binding Height, Mode=TwoWay}" />
                </Grid>
                <NumberBox
                    x:Name="ZoomBox"
                    x:Uid="MapImageExportZoom"
                    AutomationProperties.AutomationId="MapImageExportZoom"
                    Header="Zoom"
                    LargeChange="1"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Inline" />
                <ComboBox
                    x:Uid="MapImageExportTextScale"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="MapImageExportTextScale"
                    Header="Text size"
                    ItemsSource="{Binding TextScaleChoices}"
                    SelectedIndex="{Binding TextScaleIndex, Mode=TwoWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="MapImageExportStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{Binding StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="MapImageExportRetry"
                    AutomationProperties.AutomationId="MapImageExportRetry"
                    Click="OnRetryClicked"
                    Content="Retry"
                    Visibility="{Binding RetryVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
