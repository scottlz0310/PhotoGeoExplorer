<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(WindowsPackageType)'==''">None</WindowsPackageType>
    <Platforms>x64;ARM64</Platforms>
    <RootNamespace>PhotoGeoExplorer</RootNamespace>
    <Version>1.12.0</Version>
    <AssemblyVersion>1.12.0.0</AssemblyVersion>
    <FileVersion>1.12.0.0</FileVersion>
    <InformationalVersion>1.12.0</InformationalVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <WindowsSdkPackageVersion>10.0.26100.81</WindowsSdkPackageVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <!-- 非パッケージ起動は参照 SDK のランタイムを同梱し、端末や CI の登録状態に依存させない。 -->
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)'=='' and '$(WindowsPackageType)'=='None'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkAutoInitialize Condition="'$(WindowsAppSDKSelfContained)'=='true' and '$(WindowsPackageType)'=='None'">true</WindowsAppSdkAutoInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(WindowsAppSDKSelfContained)'=='true' and '$(WindowsPackageType)'=='None'">true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- MSIX Packaging Configuration for WACK Compliance -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <!-- Localization: Default language and supported languages for PRI/MSIX generation -->
    <!-- Store 配信時に AppxManifest.xml の Resources に en-US/ja-JP が出力される -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <Languages>en-US;ja-JP</Languages>
    <!-- MakePri に言語リソースを明示的に指定 -->
    <AppxDefaultResourceQualifiers>Language=en-US;ja-JP</AppxDefaultResourceQualifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- mspdbcmf.exe パス構築バグ (MSB6011/HarfBuzzSharp) 回避: DebugType=none でシンボルパッケージ不要 -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Mapsui" Version="5.2.0" />
    <PackageReference Include="Mapsui.WinUI" Version="5.2.0" />
    <PackageReference Include="Mapsui.Nts" Version="5.2.0" />
    <PackageReference Include="Mapsui.Rendering.Skia" Version="5.2.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="PhotoMapStudio.Rendering" Version="0.2.0" />
  </ItemGroup>

  <!-- PhotoMapStudio.Rendering は SkiaSharp 4.156.0 に依存する。Mapsui 5.1.0 は 3.119.x の Skia 系を引くため、
       版の不一致で実行時に失敗しないよう、Skia 系は同じ版を明示する（Renovate は C# の依存関係として一括で更新する） -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WinUI" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.156.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoGeoExplorer.Core\PhotoGeoExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\\MapPins\\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\\MapAttribution\\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="wwwroot\\**\\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

