  <data name="Dialog.Help.Basics.Title" xml:space="preserve">
    <value>Basic operations</value>
  </data>
  <data name="Dialog.Help.Basics.Detail" xml:space="preserve">
    <value>- Use the file browser on the left to navigate folders and select files.
- Change view mode (Icon/List/Details) from the View menu.
- Use Ctrl/Shift for multi-selection.
- Use the preview buttons to zoom, fit, or maximize.
- Drag to pan the map, use the wheel to zoom, and click pins for details.</value>
  </data>
